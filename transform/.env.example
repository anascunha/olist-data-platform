# Conexão Databricks (SQL Warehouse)
# HTTP path: SQL Warehouses -> seu warehouse -> Connection details
DBT_DATABRICKS_HOST=dbc-xxxxxxxx.cloud.databricks.com
DBT_DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxx
DBT_DATABRICKS_CATALOG=sandbox # sandbox ou producao
DBT_DATABRICKS_SCHEMA=dbt_seunome
TARGET_ENV="dev" # ou prod

# Só para o target prod. O target dev autentica via OAuth (login pelo navegador), sem token.
# Em automação, prefira um service principal a um token pessoal.
# DBT_DATABRICKS_TOKEN=
