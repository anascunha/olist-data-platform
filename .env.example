# Kaggle API Credentials (necessário para o download dos dados)
# Obtenha em kaggle.com -> Settings -> API -> Create New Token
KAGGLE_USERNAME=seu_usuario_aqui
KAGGLE_KEY=sua_chave_aqui

# Databricks: NÃO coloque host/token aqui.
# - A CLI (usada por make ingest / make crm) autentica via OAuth: databricks auth login
#   Variáveis DATABRICKS_HOST/DATABRICKS_TOKEN neste arquivo teriam prioridade sobre o login.
# - O dbt tem o próprio arquivo: transform/.env (ver transform/.env.example)

# Groq API (reservado para o agente NL2SQL planejado — ainda não utilizado)
GROQ_API_KEY=
